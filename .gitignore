# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/

# Virtual environments and packaging
.venv/
venv/
env/
*.egg-info/
build/
dist/
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db-wal
*.db-shm

# Local runtime data, tools and agent state
data/
/forge/.forge-locks/
/.tools/
/.superpowers/
/.codex/
/.aws/
*.log

# Secrets; keep distributable environment templates visible
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# Test coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/

# OS and editor temporary files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
# Intentionally staged Docker build input; generated by docker/build-image.sh.
docker/vendor/*.whl
docker/vendor/ebinex-sdk.lock
